    "bytes": 1974,
    "text": "# @spec docs/BACKLOG.md#sls-147 | docs/CODE_EDITOR_READ_CONCURRENCY.md#barrière-native-retenue\n# @verifies docs/BACKLOG.md#sls-147 | docs/SCHEMA_011_REGRESSIONS.md#exécution-preuves-et-clôture\n\"\"\"Retain exact surviving native held checkpoints, with no replay or live trace.\"\"\"\nimport hashlib,json,runpy,subprocess,sys\nfrom pathlib import Path\nwork=Path(sys.argv[1]);closed=json.loads((work/'reader-guards-final.json').read_bytes());units=[x['unit']for x in closed['guards']];assert len(units)==6\nprogram='units='+repr(units)+'\\n'+r'''\nimport hashlib,json,os,re,socket,time\nfrom pathlib import Path\nassert socket.gethostname()=='infra-serverless'and os.geteuid()==0\nresult=[]\nfor unit in units:\n assert re.fullmatch('serverless-restore-editor-read-[0-9a-f]{32}',unit)\n folder=Path('/run')/unit;path=folder/'held.json'\n assert folder.resolve()==folder and path.is_file()and not path.is_symlink()\n raw=path.read_bytes();assert len(raw)<2*1024**2\n value=json.loads(raw);assert value['event']=='held'and value['unit']==unit\n result.append({'path':str(path),'sha256':hashlib.sha256(raw).hexdigest(),'bytes':len(raw),'text':raw.decode(),'mtime_ns':path.stat().st_mtime_ns})\nprint(json.dumps({'completed':True,'sampled_at_ns':time.time_ns(),'held':result,'groups_added':0}))\n'''\nssh=runpy.run_path('e2e/schedule_regressions.py')['SSH'];p=subprocess.run(ssh+['python3 -B -'],input=program,text=True,capture_output=True,check=True,timeout=45)\nv=json.loads(p.stdout);assert v['completed']and len(v['held'])==6\nv['collector_sha256']=hashlib.sha256(Path(__file__).read_bytes()).hexdigest();target=work/'reader-held-native-diagnostic.json';assert not target.exists();target.write_text(json.dumps(v,indent=2)+'\\n');target.chmod(0o600)\nlast=json.loads(v['held'][-1]['text']);print(json.dumps({'completed':True,'held_checkpoints':6,'last_readers':len(last['readers']),'last_clones':len(last['clone_events']),'last_threads_seen':last['threads_seen'],'path':str(target),'groups_added':0}))\n"
  },
